# Exemplo sem segredos. Configurar somente no painel protegido do servidor.
# O código aceita exclusivamente sandbox; production é recusado.
PAGBANK_ENVIRONMENT=sandbox
SITE_ORIGIN=https://nour.example.invalid

# Vazio = modo mock, persistido no Postgres, sem chamada ao PagBank ou URL de pagamento.
# Para homologação futura, preencher SOMENTE no painel seguro com token Sandbox.
PAGBANK_API_TOKEN=

# Segredo aleatório independente (mínimo 32 caracteres), apenas servidor.
# Usado para HMAC do IP nos contadores de abuso. Nunca pedir ou enviar pela conversa.
CHECKOUT_ABUSE_SECRET=

# Rotas de webhook/status continuam bloqueadas nesta etapa.
PAGBANK_WEBHOOK_AUTH_MODE=UNCONFIRMED
SAMUEL_WHATSAPP_NUMBER=NUMERO_FICTICIO_A_CONFIRMAR

# @netlify/database obtém NETLIFY_DB_URL / NETLIFY_DB_DRIVER da plataforma.
# Nenhuma DSN real neste arquivo. Banco não é provisionado pela aplicação.
# Sem token o mock ainda exige banco/origem/segredo; use npm run preview:checkout
# para simulação local isolada, que ignora as credenciais do ambiente.
# Nunca usar PUBLIC_, VITE_ ou NEXT_PUBLIC_ para segredos.
